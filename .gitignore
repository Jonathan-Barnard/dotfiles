# ── save this as .gitignore in the repo root ───────────────────────────────

# secrets and machine-specific overrides — never commit
.zshrc.local
*.local
.env
*.pem
*.key

# generated by the shell, not by you
.zsh_history
.zcompdump*
.zcompcache/

# fetched by the installers, not authored here
zsh/plugins/
bat/themes/

# neovim plugin payload and state — hundreds of MB, all reproducible
nvim/lazy/
nvim/nvim-pack-lock.json
nvim/spell/

# backups the installers leave behind
.dotfiles-backup/
*.bak
*~

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Do NOT ignore nvim/lazy-lock.json — that file pins your exact plugin
# versions and is the thing that makes a fresh clone reproduce this setup.
